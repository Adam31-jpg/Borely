# ───────────────────────────────────────────
# Borely — Variables d'Environnement
# Copier ce fichier : cp .env.local.example .env.local
# Ne JAMAIS commiter .env.local
# ───────────────────────────────────────────

# ─── Base de données (PostgreSQL) ───────────
DATABASE_URL="postgresql://postgres:@borely-db.cev6mgksovif.us-east-1.rds.amazonaws.com:5432/postgres"
# ─── Auth.js v5 (NextAuth) ──────────────────
# URL du site (sans slash final) — Auth.js v5 utilise AUTH_URL (pas NEXTAUTH_URL)
AUTH_URL="http://localhost:3001"
# openssl rand -base64 32
# Auth.js v5 cherche AUTH_SECRET en priorité ; NEXTAUTH_SECRET est accepté en fallback.
AUTH_SECRET="/="
# Alias v4 (optionnel, supporté en fallback)
# NEXTAUTH_SECRET="your-secret-here"

# ─── Google OAuth (Gmail API) ───────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Scopes requis : gmail.readonly + gmail.modify
# URI de redirection autorisée : http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID="-.pps..com"
GOOGLE_CLIENT_SECRET="G"

# ─── AWS (KMS) ──────────────────────────────
AWS_REGION="eu-west-3"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# ARN de la clé KMS pour chiffrer les tokens OAuth
AWS_KMS_KEY_ID=""

# ─── Creem.io (Paiements) ───────────────────
CREEM_API_KEY="your-creem-api-key"
CREEM_WEBHOOK_SECRET="your-creem-webhook-secret"
